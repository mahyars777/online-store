# URL reachable by the Next.js server. If both containers share a Docker network, use http://api:4000
BACKEND_API_URL=http://localhost:4000

# Must match the ADMIN_API_KEY configured in the backend Admin Edition
BACKEND_ADMIN_API_KEY=replace-with-the-same-long-random-key

# Password used to enter this Next.js admin panel (choose a separate strong password)
ADMIN_PANEL_PASSWORD=change-this-panel-password

# Random secret used to sign the admin session cookie (32+ random characters)
SESSION_SECRET=replace-with-a-long-random-session-secret

# Public API base path used by the browser
NEXT_PUBLIC_API_BASE=/api/backend\nNEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:4000
